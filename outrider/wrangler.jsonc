// Outrider wrangler config. Bindings mirror the Cloudflare Sandbox SDK guide
// (https://developers.cloudflare.com/sandbox/guides/backup-restore/).
//
// VERIFY at first deploy:
//   - containers[].image path (relative to this file -> "../mount")
//   - the KV namespace id (create one: `wrangler kv namespace create RANGE_KV`)
//   - CLOUDFLARE_ACCOUNT_ID + the R2 bucket exists (`wrangler r2 bucket create range-saddlebags`)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koboi-range-outrider",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],

  // The Mount image: a `Sandbox` class that is BOTH a containers binding (the image)
  // AND a durable_objects binding (the per-session coordinator the SDK drives).
  "containers": [
    { "class_name": "Sandbox", "image": "../mount/Dockerfile" }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" }
  ],

  // RANGE_KV = the session registry (status + Saddlebag handles).
  // 👇 REQUIRED before first deploy: create the namespace and paste its id here
  //     npx wrangler kv namespace create RANGE_KV
  "kv_namespaces": [
    { "binding": "RANGE_KV", "id": "<replace-with-kv-namespace-id>" }
  ],

  // BACKUP_BUCKET = where createBackup() writes the squashfs Saddlebags.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "range-saddlebags" }
  ],

  "vars": {
    "BACKUP_BUCKET_NAME": "range-saddlebags",
    "CLOUDFLARE_ACCOUNT_ID": "<YOUR_ACCOUNT_ID>",
    "MOUNT_CONFIG": "/app/config/finance.yaml",
    // PUBLIC_DOMAIN = the Worker's public hostname. exposePort() mints the live-token streaming preview
    // URL under it as <port>-<sid>-<token>.<PUBLIC_DOMAIN>. It MUST be a DEDICATED zone apex you control
    // solely for this Worker -- a root domain you own (e.g. "koboi-range.dev"), NOT a subdomain of a
    // shared zone. Why: the streaming route below is a wildcard that claims the WHOLE zone, so putting it
    // on a SHARED zone's apex (e.g. *.lab-sandbox.dev) shadows every other project on that zone (real
    // incident: *.lab-sandbox.dev/* made an unrelated sibling worker's /healthz answer as the Outrider).
    // A dedicated root domain keeps preview URLs at ONE level (*.your-domain) -> covered by free Universal
    // SSL; a deeper subdomain (*.range.your-domain) needs Advanced Certificate Manager or a self-uploaded
    // Let's Encrypt wildcard, and delegating one as its own "subdomain zone" is Enterprise-only on CF.
    "PUBLIC_DOMAIN": "<YOUR_DEDICATED_ROOT_DOMAIN e.g. koboi-range.dev>"
  },

  // Wave-1 streaming route (uncomment + fill in <PUBLIC_DOMAIN> at deploy time). The pattern's zone MUST
  // match PUBLIC_DOMAIN. Deploy steps: add the zone to Cloudflare; add a proxied wildcard DNS record
  //   `A  *  192.0.2.0  Proxied`   (RFC 5737 doc address -- the Worker intercepts before any origin
  //   connect, so the IP never matters); wait for Universal SSL on *.<PUBLIC_DOMAIN>; `wrangler deploy`.
  // "routes": [
  //   { "pattern": "*.<YOUR_DEDICATED_ROOT_DOMAIN>/*", "zone_name": "<YOUR_DEDICATED_ROOT_DOMAIN>" }
  // ],

  // The Range heartbeat -- 1/min, same cadence as the Devin Outposts template.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
